<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- هدر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_room"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvRoomSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connecting"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live"
            android:textSize="11sp"
            android:textColor="@color/accent_green"
            android:background="@drawable/bg_live_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"/>

    </LinearLayout>

    <!-- کارت اعضا -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/group_members"
                android:textSize="11sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/accent_green"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <LinearLayout
                android:id="@+id/membersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

    </LinearLayout>

    <!-- بخش دکمه PTT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/pttRipple3"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ptt_outer"
                android:alpha="0"/>

            <View
                android:id="@+id/pttRipple2"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ptt_outer"
                android:alpha="0"/>

            <View
                android:id="@+id/pttOuter"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ptt_outer"/>

            <TextView
                android:id="@+id/btnPTT"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/ripple_ptt"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🎤"
                android:textSize="36sp"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvPttHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hold_to_speak"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="14dp"/>

    </LinearLayout>

    <!-- بخش پایین: حالت میکروفون + خروج -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- کارت حالت میکروفون -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mic_mode"
                android:textSize="13sp"
                android:textColor="@color/text_primary"/>

            <!-- دکمه تگل حالت میکروفون -->
            <TextView
                android:id="@+id/btnMicToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/push_to_talk"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_button_primary"/>

        </LinearLayout>

        <!-- دکمه خروج -->
        <TextView
            android:id="@+id/btnLeaveRoom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/leave_room"
            android:textSize="14sp"
            android:textColor="@color/danger_text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_danger"/>

    </LinearLayout>

</LinearLayout>
